{
  "name": "openai-compatible-imagegen",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "npm run build && node scripts/build-release-artifacts.mjs",
    "check": "node scripts/check-plugin.mjs",
    "prepare:personal": "node scripts/prepare-personal-plugin.mjs",
    "probe": "node scripts/probe-plugin.mjs",
    "stage:personal": "node scripts/stage-personal-plugin.mjs",
    "test": "npm run test:smart",
    "test:smart": "node scripts/test-smart.mjs",
    "test:release": "node scripts/run-tests.mjs --release",
    "verify:release": "npm run build && npm run test:release && npm run check && python -m compileall -q scripts && git diff --check",
    "test:suite": "node scripts/test-suite.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "lucide": "^0.468.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "jsdom": "^26.1.0"
  }
}
